# PostgreSQL usado pelo Atacado Shop
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Use "require" apenas se seu PostgreSQL exigir SSL
PGSSL=disable

# Porta interna do container. No Easypanel, mantenha 80.
PORT=80

# Uploads de foto/vídeo. Monte um volume persistente em /data no Easypanel.
DATA_DIR=/data
