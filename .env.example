# Configuração de referência: não salvar segredos reais neste arquivo.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# URL HTTPS usada pelo backend para links e callbacks.
SHOPVAX_PUBLIC_URL=https://shopvax.com.br

# SHA completo do commit publicado (registrar em cada deploy no EasyPanel).
# O endpoint GET /health expõe somente esta referência pública.
SHOPVAX_RELEASE_SHA=sha-do-commit-publicado

# Necessário quando integrações com segredos cifrados estão ativas.
# Gerar valor forte e manter estável entre reinícios/deploys.
SHOPVAX_INTEGRATION_SECRET=trocar-por-valor-aleatorio-longo-e-estavel

# Apenas em instalação inicial; remover após o primeiro administrador.
# SHOPVAX_ADMIN_BOOTSTRAP_TOKEN=gerar-valor-forte-com-mais-de-24-caracteres

# Opcional, caso login Google seja efetivamente utilizado.
# GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Não habilitar mocks de pagamento nem bypass de segurança em produção.
# SHOPVAX_ASAAS_MOCK, SHOPVAX_PLAN_LIMITS_DISABLED e
# SHOPVAX_SECURITY_RATE_LIMIT_DISABLED devem permanecer desativados.

# Migração comercial versionada v3: habilitar SOMENTE depois de backup,
# auditoria de planos ativos e aprovação da janela de publicação; depois desligar.
# SHOPVAX_APPLY_APPROVED_PLAN_LIMITS=1
\n
# Assinaturas Stripe da plataforma (somente backend, nunca VITE_ / frontend).
# Novos cadastros são liberados sem cobrança por padrão, mesmo com Stripe configurada.
# Para exigir pagamento de NOVAS lojas, ative explicitamente no backend:
# SHOPVAX_REQUIRE_PAYMENT_ON_SIGNUP=1
# Lojas existentes não mudam de status automaticamente.
# SHOPVAX_STRIPE_SECRET_KEY=sk_test_...
# SHOPVAX_STRIPE_WEBHOOK_SECRET=whsec_...
# Endpoint: https://shopvax.com.br/api/billing/stripe/webhook
# Veja docs/STRIPE_BILLING.md antes de ativar produção.

# Login global de compradores pelo WhatsApp da central UAZAPI (liberação gradual).
# Não configura nem sobrescreve os webhooks/fluxos existentes da central.
# SHOPVAX_BUYER_WHATSAPP_LOGIN=1
# UAZAPI_BASE_URL=https://sua-instancia-uazapi.example
# UAZAPI_INSTANCE_TOKEN=token-secreto-da-instancia
# SHOPVAX_OTP_HMAC_SECRET=gere-uma-chave-aleatoria-de-32-bytes-ou-mais
# Se ausente, reutiliza com HKDF a chave SHOPVAX_INTEGRATION_SECRET (mínimo 32 caracteres).
# SHOPVAX_BUYER_WHATSAPP_LOGIN=1 continua obrigatório para ativar o envio.

# Redis privado do EasyPanel (não salvar senha real no GitHub).
# REDIS_URL=redis://default:senha@shopvax_redis:6379
# SHOPVAX_CATALOG_CACHE_TTL_SECONDS=15
# SHOPVAX_PUBLIC_CURSOR_SECRET=uma-chave-aleatoria-com-pelo-menos-32-caracteres
# SHOPVAX_MEDIA_WORKER_DISABLED=0
# SHOPVAX_MEDIA_WORKER_CONCURRENCY=1
# SHOPVAX_PUBLIC_CATALOG_RATE_LIMIT_DISABLED=0  # somente STAGING de carga isolada

# Observabilidade protegida: 404 sem token >=32 caracteres; nunca usar token no frontend.
# SHOPVAX_METRICS_TOKEN=uma-chave-de-monitoramento-forte-e-privada

# Origens HTTPS externas autorizadas a hospedar imagens e vídeos de produtos.
# A CSP permite mídias próprias (/media) e fornecedores conhecidos por padrão.
# Cadastre APENAS as origens adicionais realmente usadas pelos lojistas.
# Ex.: SHOPVAX_CSP_MEDIA_ORIGINS=https://cdn.seuprovedor.com,https://videos.seuprovedor.com
# Não inclua curingas (*), caminhos, endereços IP internos nem credenciais.
# SHOPVAX_CSP_MEDIA_ORIGINS=
