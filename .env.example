# Shopvax — ambiente de produção
# Nunca versione valores reais de senha/token neste arquivo.

# Obrigatório: PostgreSQL da aplicação.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Obrigatório para lançamento: URL pública HTTPS usada em callbacks e links absolutos.
SHOPVAX_PUBLIC_URL=https://shopvax.seudominio.com.br

# Obrigatório para lançamento: segredo estável (32+ caracteres) que cifra credenciais de integrações.
# Não troque este valor depois de cadastrar chaves Asaas/webhooks sem antes migrar as credenciais.
SHOPVAX_INTEGRATION_SECRET=gere-um-segredo-longo-aleatorio-e-estavel

# Somente na PRIMEIRA ativação de uma instalação sem administradores.
# Remova do ambiente depois de criar o primeiro administrador em /admin.
# SHOPVAX_ADMIN_BOOTSTRAP_TOKEN=gere-um-token-unico-com-24-ou-mais-caracteres

# Opcional: tolerância de cobrança antes da suspensão automática. Padrão: 7 dias.
# SHOPVAX_BILLING_GRACE_DAYS=7

# Segurança/limites devem permanecer ligados em produção.
# NÃO use estas flags com valor 1 em produção:
# SHOPVAX_PLAN_LIMITS_DISABLED=1
# SHOPVAX_SECURITY_RATE_LIMIT_DISABLED=1

# Exclusivo de testes automatizados. NÃO usar em produção:
# SHOPVAX_ASAAS_MOCK=1
