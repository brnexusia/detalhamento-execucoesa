# Internal PaddleOCR CPU worker. Deploy as a PRIVATE EasyPanel service.
# Keep this large ML runtime outside the web/API container.
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    PDF_OCR_PORT=8088
RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir paddlepaddle==3.2.0 \
      -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && python -m pip install --no-cache-dir paddleocr==3.7.0
RUN useradd --create-home --uid 10001 ocr
COPY server/paddle-ocr-service.py /app/paddle-ocr-service.py
USER ocr
ENV HOME=/home/ocr
EXPOSE 8088
CMD ["python", "/app/paddle-ocr-service.py"]
